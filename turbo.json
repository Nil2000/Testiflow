{
  "$schema": "https://turbo.build/schema.json",
  // ponytail: loose until we list passThroughEnv per task. Root/package scripts load .env via dotenv-cli.
  "envMode": "loose",
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["generated/**"]
    },
    "vercel:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "^db:generate", "db:generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "vercel:build": {
      "dependsOn": ["^vercel:generate"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^db:generate", "db:generate"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^db:generate", "db:generate"]
    }
  },
  "ui": "tui"
}
